<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # Force HTTPS - without this, a visitor reaching the site over plain
    # http:// (an old link, a mistyped URL, a stale bookmark) gets served
    # the page insecurely, and since SESSION_SECURE_COOKIE=true in
    # production, their browser then refuses to persist the Secure-flagged
    # session/XSRF cookies at all - every state-changing request (add to
    # cart, checkout, anything) then 419s with "CSRF token mismatch".
    # Confirmed live: a customer hit exactly this trying to buy the 3-pack.
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Preserve headers required by Laravel Sanctum.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:X-XSRF-TOKEN} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Existing frontend assets and uploaded files are served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Laravel endpoints share the main domain with the React application.
    RewriteRule ^(api(?:/.*)?|sanctum(?:/.*)?|sitemap\.xml|up)$ laravel.php [QSA,L]

    # React Router fallback.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

