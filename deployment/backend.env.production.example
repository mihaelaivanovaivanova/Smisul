APP_NAME=Smisul
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.BG

APP_LOCALE=bg
APP_FALLBACK_LOCALE=bg
APP_FAKER_LOCALE=bg_BG
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_DATABASE
DB_USERNAME=CPANEL_DB_USER
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=YOUR-DOMAIN.BG
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

FRONTEND_URL=https://YOUR-DOMAIN.BG
FRONTEND_URLS=https://YOUR-DOMAIN.BG
SANCTUM_STATEFUL_DOMAINS=YOUR-DOMAIN.BG,www.YOUR-DOMAIN.BG

ADMIN_EMAIL=admin@YOUR-DOMAIN.BG
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
CONTACT_EMAIL=contact@YOUR-DOMAIN.BG

# SuperHosting (and likely other shared-hosting plans) blocks outbound raw
# SMTP socket connections from PHP scripts entirely - confirmed by testing
# smtp against mail.smisul.bg on every port cPanel's own mail-client-config
# page lists (465, 26) and even localhost:25, all "Connection refused".
# sendmail shells out to the server's local Exim binary directly instead of
# opening a TCP socket, and gets through where smtp cannot - use it here,
# not smtp, on this kind of host. The smtp-only settings (host/port/scheme/
# username/password) don't apply to sendmail and are omitted below - the
# From address is what determines the sending mailbox instead.
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=contact@YOUR-DOMAIN.BG
MAIL_FROM_NAME="${APP_NAME}"

ICARD_MID=
ICARD_MID_NAME=Smisul
ICARD_ORIGINATOR=
ICARD_KEY_INDEX=
ICARD_KEY_INDEX_RESP=
ICARD_IPG_VERSION=4.5
ICARD_CURRENCY_NUMERIC=978
ICARD_ENVIRONMENT=sandbox
ICARD_BASE_URL=https://dev-ipg.icards.eu/sandbox/
ICARD_MODAL_JS_URL=https://dev-ipg.icards.eu/sandbox/js/payment-modal.js
ICARD_WALLET_JS_URL=https://dev-ipg.icards.eu/sandbox/js/icard-g-a-pay.min.js
ICARD_WEBHOOK_URL="${APP_URL}/api/v1/payments/webhook/icard"
ICARD_CALLBACK_IPS=

# Surcharge for choosing cash on delivery (Speedy only) - see PaymentMethod::fee().
CASH_ON_DELIVERY_FEE=0.50

# Shipping providers (Speedy, BOX NOW). Speedy requires a real account
# (username/password) or every quote/office/shipment request is rejected.
# Use the production account's own credentials here, not the sandbox/test
# account used in local development - Speedy's live and test accounts share
# the same base URL, so only the username/password differ. A locker/APT
# (automated machine) shipment additionally requires the account holder to
# complete Speedy's own identity verification first, separately from these
# credentials: https://myspeedy.speedy.bg/verification
SPEEDY_BASE_URL=https://api.speedy.bg/v1/
SPEEDY_USERNAME=
SPEEDY_PASSWORD=
# Every Speedy shipment is a self drop-off, not a courier pickup - office
# 345 ("СОФИЯ - СТУДЕНТСКИ ГРАД, СРЕЩУ БЛ. 34А") is where parcels are
# physically handed off. Change only if that changes; look up a new id via
# a location/office API call, not by guessing.
SPEEDY_DROPOFF_OFFICE_ID=345

BOX_NOW_BASE_URL=https://api-production.boxnow.bg/api/v1/
BOX_NOW_CLIENT_ID=
BOX_NOW_CLIENT_SECRET=
# "any-apm" is BOX NOW's location TYPE, not a valid numeric locationId - the
# API rejects it (P400: "locationId must match format integer"). "2" is this
# account's own any-apm wildcard origin, confirmed via a live GET /origins
# call; see config/services.php's own comment on this same value.
BOX_NOW_ORIGIN_LOCATION_ID=2
