APP_NAME=Smisul
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smisul
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@smisul.bg"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend / SPA integration
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,localhost:8000,127.0.0.1:5173

# Seeded administrator account (required — seeder fails if unset)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the public contact form (frontend footer) delivers submissions
CONTACT_EMAIL=contact@smisul.bg

# iCard IPG API. Private/public key files go at storage/icard/*.pem
# (gitignored, never committed) — see config/services.php.
ICARD_MID=
ICARD_MID_NAME="Smisul"
ICARD_ORIGINATOR=
ICARD_KEY_INDEX=
ICARD_KEY_INDEX_RESP=
ICARD_IPG_VERSION=4.5
ICARD_CURRENCY_NUMERIC=978
ICARD_ENVIRONMENT=sandbox
ICARD_BASE_URL=https://dev-ipg.icards.eu/sandbox/
ICARD_MODAL_JS_URL=https://dev-ipg.icards.eu/sandbox/js/payment-modal.js
ICARD_WALLET_JS_URL=https://dev-ipg.icards.eu/sandbox/js/icard-g-a-pay.min.js
ICARD_WEBHOOK_URL="${APP_URL}/api/v1/payments/webhook/icard"
ICARD_CALLBACK_IPS=

# Shipping providers (Econt, Speedy, BOX NOW). Econt/Speedy are still
# sandbox/demo — checkout works without them (see App\Services\Shipping);
# only shipment creation/tracking need real credentials. BOX NOW is
# configured against its real production API — get credentials from BOX
# NOW's partner onboarding (see https://boxnow.bg/partner-api).
ECONT_BASE_URL=https://demo.econt.com/ee/services/
ECONT_USERNAME=
ECONT_PASSWORD=

SPEEDY_BASE_URL=https://api.speedy.bg/v1/
SPEEDY_USERNAME=
SPEEDY_PASSWORD=

BOX_NOW_BASE_URL=https://api-production.boxnow.bg/api/v1/
BOX_NOW_CLIENT_ID=
BOX_NOW_CLIENT_SECRET=
BOX_NOW_ORIGIN_LOCATION_ID=any-apm
